{
  "name": "dsh-team-manager",
  "version": "0.2.2",
  "description": "TeamManeger — Skill 与 Subagent 统一管理，内置可独立开关的会话回收站。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./recycle": {
      "default": "./lib/recycle/component.js"
    },
    "./recycle/locale/*.json": "./lib/recycle/locale/*.json",
    "./recycle/icon": "./lib/recycle/icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/images",
    "docs/DEVELOPMENT.md",
    "examples",
    "LICENSE",
    "icon.svg",
    "locale",
    "tools"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-team-manager",
    "skill",
    "subagent",
    "settings"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --import ./tools/test-stub-resolver.mjs tools/test-all.mjs"
  }
}
